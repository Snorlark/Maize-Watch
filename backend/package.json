{
  "name": "maize-watch-backend",
  "version": "1.0.0",
  "description": "Backend API for Maize-Watch IoT Agriculture Monitoring System",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc --noEmitOnError false --skipLibCheck --strict false --target ES2020 --module commonjs --outDir dist --rootDir src --esModuleInterop --allowJs --allowSyntheticDefaultImports --moduleResolution node --resolveJsonModule --skipDefaultLibCheck src/**/*.ts",
    "start": "node dist/src/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:watch": "nodemon --exec ts-node --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "seed": "ts-node scripts/seed.ts",
    "docker:build": "docker build -t maize-watch-backend .",
    "docker:run": "docker run -p 8080:8080 maize-watch-backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snorlark/Maize-Watch.git"
  },
  "keywords": [
    "agriculture",
    "iot",
    "monitoring",
    "nodejs",
    "typescript",
    "express"
  ],
  "author": "Maize-Watch Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Snorlark/Maize-Watch/issues"
  },
  "homepage": "https://github.com/Snorlark/Maize-Watch#readme",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.4",
    "speakeasy": "^2.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.9.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
