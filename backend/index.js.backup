import express from 'express';
import cors from 'cors';
import bodyParser from 'body-parser';
import mongoose from 'mongoose';
import dotenv from 'dotenv';
import path from 'path';
import { fileURLToPath } from 'url';
import userRoutes from './routes/user.route.js';
import { MongoClient, ObjectId } from 'mongodb';
import cron from 'node-cron';
import bcrypt from 'bcrypt';
import jwt from 'jsonwebtoken';

import cornRoutes from './routes/corn.route.js'
import sensorDataRoutes from './routes/sensor_data.route.js';
import analyticsRoutes from './routes/analytics.route.js';
import thingSpeakService from './services/thingspeak.services.js';
import { isAdmin, isAuthenticated } from './middleware/auth.middleware.js';
import cornAnalysisRoutes from './routes/cornAnalysis.route.js';
import { iotConnection } from './services/cornAnalysis.service.js';
import AnalyticsService from './services/analytics.service.js';
import authRoutes from './routes/auth.route.js';
import activityLogRoutes from './routes/activityLog.route.js';
import { logActivity } from './middleware/activityLog.middleware.js';
import User from './models/user.model.js'; // Import the Mongoose User model

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Load environment variables from .env file
dotenv.config({ path: path.resolve(__dirname, '../.env') });

const app = express();
const port = process.env.PORT || 8080;

// Store database connections
let mainDb; // Native MongoDB driver connection

// Connect to MongoDB
const connectToMongo = async () => {
  try {
    const client = new MongoClient(process.env.MONGODB_URI);
    await client.connect();
    mainDb = client.db('maize_watch');
    console.log('Connected to MongoDB');
  } catch (error) {
    console.error('MongoDB connection error:', error);
  }
};

// JWT middleware
const isAuthenticated = (req, res, next) => {
  const token = req.headers.authorization?.split(' ')[1];
  
  if (!token) {
    return res.status(401).json({ error: 'Access denied. No token provided.' });
  }
  
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET);
    req.user = decoded;
    next();
  } catch (error) {
    res.status(400).json({ error: 'Invalid token.' });
  }
};

// Admin middleware
const isAdmin = (req, res, next) => {
  if (req.user.role !== 'admin' && req.user.role !== 'super_admin') {
    return res.status(403).json({ error: 'Access denied. Admin privileges required.' });
  }
  next();
};

// Connect to MongoDB using URI from environment
mongoose.connect(process.env.MONGODB_URI, {
    useNewUrlParser: true,
    useUnifiedTopology: true
})
.then(() => {
    console.log('Connected to MongoDB successfully');
    connectToMongo(); // Also connect with native driver
})
.catch(err => console.error('MongoDB connection error:', err));

// Middleware
app.use(cors({
  origin: process.env.CLIENT_URL || '*',
}));
app.use(bodyParser.urlencoded({ extended: true }));
app.use(bodyParser.json());
app.use(express.json());

// Routes
app.use('/api/auth', authRoutes);
app.use('/api/sensors', sensorDataRoutes);
app.use('/api/corn', cornRoutes);
app.use('/api/corn-analysis', cornAnalysisRoutes);
app.use('/api/analytics', analyticsRoutes);
app.use('/api/activity-logs', activityLogRoutes);

// API Routes - Protected by admin middleware
// Get all users - admin only
app.get('/api/users', isAuthenticated, isAdmin, async (req, res) => {
  try {
    // Use Mongoose User model instead of direct MongoDB collection
    const users = await User.find({}).select('-password');
    
    // Add computed fields for activity status
    const usersWithStatus = users.map(user => {
      const now = new Date();
      const thirtyMinutesAgo = new Date(now.getTime() - 30 * 60 * 1000);
      
      // Check if user is currently active (within last 30 minutes)
      const isCurrentlyActive = user.lastActivityAt && new Date(user.lastActivityAt) > thirtyMinutesAgo;
      
      // Check if session is expired
      const isSessionExpired = user.sessionExpiresAt && new Date(user.sessionExpiresAt) < now;
      
      return {
        ...user.toObject(),
        isCurrentlyActive,
        isSessionExpired,
        // Format dates for frontend
        lastActivityAt: user.lastActivityAt ? new Date(user.lastActivityAt).toISOString() : null,
        lastLoginAt: user.lastLoginAt ? new Date(user.lastLoginAt).toISOString() : null,
        sessionExpiresAt: user.sessionExpiresAt ? new Date(user.sessionExpiresAt).toISOString() : null
      };
    });
    
    res.json(usersWithStatus);
  } catch (err) {
    console.error('Error getting users:', err);
    res.status(500).json({ error: 'Failed to fetch users' });
  }
});

// Get user activity statistics - admin only
app.get('/api/users/activity-stats', isAuthenticated, isAdmin, async (req, res) => {
  try {
    const now = new Date();
    const thirtyMinutesAgo = new Date(now.getTime() - 30 * 60 * 1000);
    const oneDayAgo = new Date(now.getTime() - 24 * 60 * 60 * 1000);
    const sevenDaysAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
    
    // Use Mongoose User model
    const allUsers = await User.find({});
    
    // Calculate statistics
    const stats = {
      totalUsers: allUsers.length,
      currentlyActive: allUsers.filter(user => 
        user.lastActivityAt && new Date(user.lastActivityAt) > thirtyMinutesAgo
      ).length,
      activeToday: allUsers.filter(user => 
        user.lastActivityAt && new Date(user.lastActivityAt) > oneDayAgo
      ).length,
      activeThisWeek: allUsers.filter(user => 
        user.lastActivityAt && new Date(user.lastActivityAt) > sevenDaysAgo
      ).length,
      mobileUsers: allUsers.filter(user => user.deviceType === 'mobile').length,
      webUsers: allUsers.filter(user => user.deviceType === 'web').length,
      roleDistribution: {
        user: allUsers.filter(user => user.role === 'user').length,
        admin: allUsers.filter(user => user.role === 'admin').length,
        super_admin: allUsers.filter(user => user.role === 'super_admin').length
      }
    };
    
    res.json(stats);
  } catch (err) {
    console.error('Error getting user activity stats:', err);
    res.status(500).json({ error: 'Failed to fetch user activity statistics' });
  }
});

// Update user activity (called by frontend and mobile)
app.post('/api/auth/activity', isAuthenticated, async (req, res) => {
  try {
    const { deviceType = 'web' } = req.body;
    const user = await User.findById(req.user.id);
    
    if (!user) {
      return res.status(404).json({ error: 'User not found' });
    }

    // Update user activity using the model method
    await user.updateActivity(deviceType);

    res.json({
      success: true,
      message: 'Activity updated successfully',
      data: {
        lastActivityAt: user.lastActivityAt,
        isActive: user.isActive
      }
    });
  } catch (error) {
    console.error('Error updating activity:', error);
    res.status(500).json({ error: 'Failed to update activity' });
  }
});

// Get user status
app.get('/api/auth/status', isAuthenticated, async (req, res) => {
  try {
    const user = await User.findById(req.user.id).select('-password');
    
    if (!user) {
      return res.status(404).json({ error: 'User not found' });
    }

    // Check if user is currently active (within last 30 minutes)
    const isCurrentlyActive = user.isCurrentlyActive;

    res.json({
      success: true,
      data: {
        user: user.toObject(),
        isCurrentlyActive,
        lastActivityAt: user.lastActivityAt,
        lastLoginAt: user.lastLoginAt,
        deviceType: user.deviceType,
        sessionExpiresAt: user.sessionExpiresAt
      }
    });
  } catch (error) {
    console.error('Error getting user status:', error);
    res.status(500).json({ error: 'Failed to get user status' });
  }
});

// Create user - admin only
app.post('/api/users', isAuthenticated, isAdmin, async (req, res) => {
  try {
    const result = await mainDb.collection('users').insertOne(req.body);
    res.status(201).json({ ...req.body, _id: result.insertedId });
  } catch (err) {
    console.error('Error creating user:', err);
    res.status(500).json({ error: 'Failed to create user' });
  }
});

// Get single user - admin only
app.get('/api/users/:id', isAuthenticated, isAdmin, async (req, res) => {
  try {
    const user = await mainDb.collection('users').findOne({ _id: new ObjectId(req.params.id) });
    if (!user) return res.status(404).json({ error: 'User not found' });
    res.json(user);
  } catch (err) {
    console.error('Error getting user:', err);
    res.status(500).json({ error: 'Failed to fetch user' });
  }
});

// Update user - admin only
app.put('/api/users/:id', isAuthenticated, isAdmin, async (req, res) => {
  try {
    const result = await mainDb.collection('users').updateOne(
      { _id: new ObjectId(req.params.id) },
      { $set: req.body }
    );
    if (result.matchedCount === 0) return res.status(404).json({ error: 'User not found' });
    res.json({ message: 'User updated successfully' });
  } catch (err) {
    console.error('Error updating user:', err);
    res.status(500).json({ error: 'Failed to update user' });
  }
});

// Delete user - admin only
app.delete('/api/users/:id', isAuthenticated, isAdmin, async (req, res) => {
  try {
    const result = await mainDb.collection('users').deleteOne({ _id: new ObjectId(req.params.id) });
    if (result.deletedCount === 0) return res.status(404).json({ error: 'User not found' });
    res.json({ message: 'User deleted successfully' });
  } catch (err) {
    console.error('Error deleting user:', err);
    res.status(500).json({ error: 'Failed to delete user' });
  }
});

// Test route
app.get('/', (req, res) => {
    res.send('Maize Watch API is running');
});

// Health check endpoint
app.get('/health', async (req, res) => {
    // Check MongoDB connections
    const isMongoConnected = mongoose.connection.readyState === 1;
    
    res.status(200).json({
      status: 'ok',
      message: 'Server is running',
      mongodb: isMongoConnected ? 'connected' : 'disconnected',
      timestamp: new Date().toISOString()
    });
});

// Error handling middleware
app.use((err, req, res, next) => {
    console.error(err.stack);
    res.status(500).json({
        message: 'Internal Server Error',
        error: process.env.NODE_ENV === 'production' ? null : err.message
    });
});

app.listen(port, '0.0.0.0', () => {
    console.log(`Server running on port ${port}`);
});
