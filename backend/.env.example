# Environment Configuration
NODE_ENV=development
PORT=3001

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_DB_NAME=maize_watch

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your_super_secure_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# API URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
MOBILE_APP_URL=http://localhost:3000

# ThingSpeak Configuration
THINGSPEAK_API_KEY=your_thingspeak_api_key_here
THINGSPEAK_CHANNEL_ID=your_channel_id_here
THINGSPEAK_READ_API_KEY=your_read_api_key_here
THINGSPEAK_WRITE_API_KEY=your_write_api_key_here

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@maizewatch.com

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:5000
PYTHON_ANALYTICS_API_KEY=your_analytics_api_key_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# SSL Configuration (for production)
SSL_CERT_PATH=
SSL_KEY_PATH=

# Hostinger Cloud Configuration
HOSTINGER_API_KEY=your_hostinger_api_key
DEPLOYMENT_ENVIRONMENT=staging
